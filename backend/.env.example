# ==========================================
# CrisisMesh AI Backend Environment Variables
# ==========================================

# Port and Host
PORT=8000
HOST=0.0.0.0

# Google Gemini API Key
# If left blank, CrisisMesh AI automatically switches to the built-in
# high-fidelity heuristic emergency triage & safety response engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK (Optional)
# If left blank, CrisisMesh AI uses its resilient in-memory & persistent demo store.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_PATH=

# Demo Mode Flag (Set to False in production)
DEMO_MODE=True
