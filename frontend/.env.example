# ==========================================
# CrisisMesh AI Frontend Environment Variables
# ==========================================

# Backend API URL (default proxy connects to localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Optional Google Maps API Key
# If omitted, CrisisMesh AI uses its built-in interactive CartoDB dark Leaflet GIS map.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Web App Config (Optional for production Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
